{
  "name": "unslop-mcp",
  "version": "2.1.1",
  "mcpName": "io.github.avivgerz-hue/unslop",
  "description": "The definitive 7-pillar UI/UX Design Engineering CLI, MCP server, and Agent Skill: 72 rules, 10 studio archetypes, multi-format tokens, and exact transformation blueprints.",
  "type": "module",
  "bin": {
    "unslop": "dist/bin/unslop.js",
    "unslop-mcp": "dist/bin/unslop.js"
  },
  "exports": {
    "./package.json": "./package.json",
    "./analyzer": {
      "types": "./dist/src/analyzer/slop-detector.d.ts",
      "default": "./dist/src/analyzer/slop-detector.js"
    },
    "./refactor-plan": {
      "types": "./dist/src/analyzer/refactor-plan.d.ts",
      "default": "./dist/src/analyzer/refactor-plan.js"
    },
    "./extractor": {
      "types": "./dist/src/extractor/extract-dna.d.ts",
      "default": "./dist/src/extractor/extract-dna.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/server.d.ts",
      "default": "./dist/src/mcp/server.js"
    },
    "./presets": {
      "types": "./dist/src/presets/index.d.ts",
      "default": "./dist/src/presets/index.js"
    },
    "./sync": {
      "types": "./dist/src/sync/rule-writer.d.ts",
      "default": "./dist/src/sync/rule-writer.js"
    },
    "./tokens": {
      "types": "./dist/src/sync/token-exporter.d.ts",
      "default": "./dist/src/sync/token-exporter.js"
    },
    "./wcag": {
      "types": "./dist/src/analyzer/wcag.d.ts",
      "default": "./dist/src/analyzer/wcag.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CITATION.cff",
    "scripts/build.mjs",
    "server.json",
    "glama.json",
    "smithery.yaml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mcp-registry",
    "mcp-tools",
    "model-context-protocol",
    "claude-code",
    "claude-skills",
    "agent-skills",
    "codex",
    "cursor",
    "cursorrules",
    "windsurf",
    "cline",
    "ai-agents",
    "design-system",
    "design-audit",
    "design-tokens",
    "ui-ux",
    "frontend",
    "frontend-design",
    "tailwind",
    "tailwindcss",
    "tailwindcss-v4",
    "wcag",
    "accessibility",
    "ai-slop",
    "anti-slop",
    "developer-tools",
    "vibe-coding",
    "css",
    "cli"
  ],
  "author": "VibeFoundry",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avivgerz-hue/unslop.git"
  },
  "homepage": "https://github.com/avivgerz-hue/unslop#readme",
  "bugs": {
    "url": "https://github.com/avivgerz-hue/unslop/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
