{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "name": "unslop",
  "displayName": "unslop — 7-Pillar Design Craft Engine",
  "description": "72-rule UI/UX audits, 10 studio archetypes, Design DNA, multi-format tokens, and transformation blueprints for coding agents.",
  "version": "2.0.0",
  "type": "mcp_server",
  "status": "stable",
  "maintainers": [
    "avivgerz-hue"
  ],
  "license": "MIT",
  "repository": "https://github.com/avivgerz-hue/unslop",
  "homepage": "https://github.com/avivgerz-hue/unslop#readme",
  "runtime": "node",
  "transport": [
    "stdio"
  ],
  "command": "npx",
  "args": [
    "-y",
    "unslop-mcp",
    "--mcp"
  ],
  "install": "npx -y unslop-mcp --mcp",
  "tools": [
    {
      "name": "unslop_audit",
      "description": "Audit JSX, HTML, Vue, Svelte, CSS, and Tailwind across 72 rules. Returns the Design Craft Score, 7-pillar scorecard, exact diagnostics, and refactoring instructions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File or directory to scan, relative to the server project root."
          },
          "ignore": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional directory base names to skip."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "unslop_extract_dna",
      "description": "Extract Design DNA from a CSS file or HTTP(S) URL and compile it into a complete design preset and Agent Skill.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "description": "CSS path or HTTP(S) URL."
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the compiled preset."
          },
          "timeoutMs": {
            "type": "number",
            "minimum": 1,
            "description": "Per-request timeout in milliseconds."
          },
          "maxStylesheets": {
            "type": "number",
            "minimum": 0,
            "description": "Maximum external stylesheets to fetch."
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "unslop_apply_preset",
      "description": "Apply a built-in studio preset across eight coding-agent ecosystems with Skills, rules, native MCP configurations, and Claude plugin metadata.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string",
            "enum": [
              "swiss-editorial",
              "linear-precision",
              "stripe-atmospheric",
              "vercel-monochrome",
              "teenage-engineering",
              "anthropic-warm-editorial",
              "bloomberg-terminal-dense",
              "raycast-command",
              "fintech-institutional",
              "neo-brutalist-craft"
            ]
          },
          "projectDir": {
            "type": "string",
            "description": "Project directory, relative to the server project root."
          }
        },
        "required": [
          "preset"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "unslop_refactor_plan",
      "description": "Generate a Design Transformation Blueprint with a 7-pillar scorecard, exact preset-aware before/after translations, and prioritized file:line refactor steps.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Component or directory to analyze, relative to the server project root."
          },
          "preset": {
            "type": "string",
            "enum": [
              "swiss-editorial",
              "linear-precision",
              "stripe-atmospheric",
              "vercel-monochrome",
              "teenage-engineering",
              "anthropic-warm-editorial",
              "bloomberg-terminal-dense",
              "raycast-command",
              "fintech-institutional",
              "neo-brutalist-craft"
            ],
            "description": "Archetype used for exact replacement classes and tokens."
          },
          "report": {
            "type": "string",
            "description": "Markdown report path (default: UNSLOP-REPORT.md)."
          },
          "ignore": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional directory base names to skip."
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "keywords": [
    "mcp",
    "design-system",
    "design-audit",
    "design-tokens",
    "tailwindcss",
    "wcag",
    "anti-slop",
    "ui-ux",
    "design-craft",
    "refactoring",
    "w3c-design-tokens"
  ]
}
